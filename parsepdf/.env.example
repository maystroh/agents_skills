# Copy to .env (next to this file, in your project, or ~/.config/parsepdf/.env)
# and fill in your LlamaCloud keys from https://cloud.llamaindex.ai.
# Add as many as you have (KEY5, KEY6, ...), or run: python scripts/parsepdf.py --add-key
# Keys are tried in turn: when one fails or runs out of credits, the next is used.
# Never commit the filled-in .env.
LLAMA_CLOUD_API_KEY=
LLAMA_CLOUD_API_KEY2=
LLAMA_CLOUD_API_KEY3=
LLAMA_CLOUD_API_KEY4=
